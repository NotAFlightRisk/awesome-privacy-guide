---
import ServiceCard from '../ui/ServiceCard.astro';
import { getModel } from '../../lib/data/model.js';
import { links } from '../../lib/routes.js';
import { langOf, translator } from '../../lib/i18n.js';
import { missing } from './missing.js';

const { section: name, limit, skip = [], only, level = 3 } = Astro.props;
const lang = langOf(Astro.url);
const { t, tr } = translator(lang);
const section = getModel().sections.find((entry) => entry.name === name);
if (!section) missing(Astro.url, 'Picks', name);
const services = (section?.services ?? [])
  .filter((svc) => (!only || only.includes(svc.slug)) && !skip.includes(svc.slug))
  .slice(0, limit);
---

{services.length > 0 && (
  <div class="picks">
    {services.map((service) => <ServiceCard service={service} lang={lang} level={level} />)}
    <p class="credit">
      <a href={links(lang).section(section)}>{t('guide.picks', { section: tr(section.name) })}</a>
    </p>
  </div>
)}

<style>
  .picks {
    display: grid;
    gap: var(--space-sm);
  }

  .credit {
    font: var(--text-xs) var(--font-mono);
  }
</style>
