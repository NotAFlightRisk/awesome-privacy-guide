---
import { langOf, translator } from '../../lib/i18n.js';

const { name } = Astro.props;
const { t } = translator(langOf(Astro.url));
---

<section class="platform" data-platform>
  <h4>{t(`platform.${name}`)}</h4>
  <slot />
</section>

<style>
  .platform {
    display: grid;
    gap: var(--space-2xs);

    &[hidden] {
      display: none;
    }
  }

  h4 {
    font: 700 var(--text-xs) var(--font-mono);
    color: var(--text-muted);
  }
</style>
