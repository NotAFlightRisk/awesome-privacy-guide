---
import { langOf, translator } from '../../lib/i18n.js';

const { t } = translator(langOf(Astro.url));
---

<div class="platforms" data-platforms data-label={t('guide.platforms')}>
  <slot />
</div>

<script>
  // Stacked without JS, tabs with it
  let count = 0;
  for (const box of document.querySelectorAll<HTMLElement>('[data-platforms]')) {
    const panels = [...box.querySelectorAll<HTMLElement>(':scope > [data-platform]')];
    const tabs = document.createElement('div');
    tabs.role = 'tablist';
    tabs.ariaLabel = box.dataset.label ?? '';
    const show = (pick: number) =>
      panels.forEach((panel, i) => {
        panel.hidden = i !== pick;
        tabs.children[i].ariaSelected = String(i === pick);
        (tabs.children[i] as HTMLElement).tabIndex = i === pick ? 0 : -1;
      });
    panels.forEach((panel, i) => {
      const heading = panel.querySelector('h4');
      const tab = Object.assign(document.createElement('button'), { type: 'button', textContent: heading?.textContent });
      tab.role = 'tab';
      tab.id = `platform-tab-${count++}`;
      panel.role = 'tabpanel';
      panel.setAttribute('aria-labelledby', tab.id);
      heading?.setAttribute('hidden', '');
      tab.addEventListener('click', () => show(i));
      tab.addEventListener('keydown', (event) => {
        const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key];
        if (!step) return;
        const next = (i + step + panels.length) % panels.length;
        show(next);
        (tabs.children[next] as HTMLElement).focus();
      });
      tabs.append(tab);
    });
    box.prepend(tabs);
    show(0);
  }
</script>

<style>
  .platforms {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-md);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .platforms :global([role='tablist']) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .platforms :global([role='tab']) {
    padding: var(--space-3xs) var(--space-sm);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: none;
    color: var(--text-muted);
    font: var(--text-sm) var(--font-body);
    cursor: pointer;

    &[aria-selected='true'] {
      border-color: var(--accent);
      background: var(--accent-soft);
      color: var(--text);
    }
  }
</style>
