---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import ServiceIcon from './ServiceIcon.astro';
import Badges from './Badges.astro';
import { links } from '../../lib/routes.js';
import { translator } from '../../lib/i18n.js';
import { compact, month } from '../../lib/format.js';

const { service, lang, showSection = false, level = 3 } = Astro.props;
const { t, tr, md } = translator(lang);
const to = links(lang);
const Title = `h${level}`;
const platforms = service.platforms.map((key) => t(`platform.${key}`));
const gh = service.github;
---

<article class="card">
  <ServiceIcon service={service} size={44} />
  <div class="body">
    <div class="head">
      <Title><a href={to.service(service)}>{service.name}</a></Title>
      {showSection && <a class="section" href={to.section(service.section)}>{tr(service.section.name)}</a>}
    </div>
    <div class="prose" set:html={md(service.description)} />
  </div>
  <div class="facts">
    {service.url && (
      <a class="visit" href={service.url} rel="noopener" data-cta="visit">
        {service.host}
        <ArrowUpRight size={14} aria-hidden="true" />
      </a>
    )}
    <Badges service={service} lang={lang} />
    {gh && !gh.archived && <p class="line">{t('facts.activity')}: {month(gh.pushed, lang)}</p>}
    {gh?.stars !== undefined && <p class="line">{t('facts.stars', { count: compact(gh.stars, lang) })}</p>}
    {platforms.length > 0 && <p class="line">{platforms.join(' · ')}</p>}
  </div>
</article>

<style>
  .card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(12rem, 16rem);
    gap: var(--space-md) var(--space-lg);
    align-items: start;
    padding: var(--space-lg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
    transition: border-color var(--quick) var(--ease);

    &:hover {
      border-color: var(--border-strong);
    }
  }

  .body {
    display: grid;
    gap: var(--space-sm);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-sm);
  }

  h2,
  h3 {
    font-size: var(--text-lg);
    letter-spacing: -0.02em;

    & a {
      text-decoration: none;
    }
  }

  .section {
    font: var(--text-xs) var(--font-mono);
    color: var(--text-faint);
  }

  .prose {
    font-size: var(--text-sm);
  }

  .facts {
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
    padding-inline-start: var(--space-lg);
    border-inline-start: 1px solid var(--border);
  }

  .line {
    font: var(--text-xs) var(--font-mono);
    color: var(--text-faint);
  }

  .visit {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    padding: var(--space-2xs) var(--space-sm);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font: var(--text-xs) var(--font-mono);
    color: var(--text-muted);
    text-decoration: none;
    overflow-wrap: anywhere;

    &:hover {
      border-color: var(--accent);
    }
  }

  @media (max-width: 48rem) {
    .card {
      grid-template-columns: auto minmax(0, 1fr);
      padding: var(--space-md);
    }

    .facts {
      grid-column: 2;
      padding-inline-start: 0;
      border-inline-start: 0;
    }
  }
</style>
